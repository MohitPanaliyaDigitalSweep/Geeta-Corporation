msgstr "નકારાત્મક સંગ્રહને મંજૂરી આપો"

msgid "Allow notifications"
msgstr "સૂચનાઓને મંજૂરી આપો"

msgid "Allow on Submit"
msgstr "સબમિટ કરવાની મંજૂરી આપો"

msgid "Allow only one session per user"
msgstr "વપરાશકર્તા દીઠ માત્ર એક સત્રની મંજૂરી આપો"

msgid "Allow page break inside tables"
msgstr "કોષ્ટકોની અંદર પૃષ્ઠ વિરામની મંજૂરી આપો"

msgid "Allow partial reservation"
msgstr "ભાગ રૂપે આરક્ષણની મંજૂરી"

msgid "Allow print"
msgstr "છાપવાની મંજૂરી આપો"

msgid "Allow purchase invoice creation without purchase order"
msgstr "પરચેઝ ઓર્ડર વિના ખરીદી ઇન્વૉઇસ બનાવવાની મંજૂરી આપો"

msgid "Allow purchase invoice creation without purchase receipt"
msgstr "ખરીદીની રસીદ વિના ખરીદી ઇન્વૉઇસ બનાવવાની મંજૂરી આપો"

msgid "Allow sales invoice creation without delivery note"
msgstr "વિતરણ વગર જ્હોનનો ઉપયોગ કરવો"

msgid "Allow sales invoice creation without sales order"
msgstr "વેચાણ ઓર્ડર વિના વેચાણ ઇન્વૉઇસ બનાવવાની મંજૂરી આપો"

msgid "Allow sales transactions with zero quantities if the rate is fixed but the quantities are not. e.g. Rate Contracts"
msgstr "શૂન્ય જથ્થા સાથે વેચાણ વ્યવહારોને મંજૂરી આપો જો દર નિશ્ચિત હોય પરંતુ જથ્થો ન હોય. દા.ત. રેટ કોન્ટ્રાક્ટ"

msgid "Allow same Item to be added multiple times in a transaction"
msgstr "એક જ વસ્તુને એક જ સમયે ટ્રાન્ઝેક્શનમાં ઉમેરવામાં આવે છે"

msgid "Allow saving if mandatory fields are not filled"
msgstr "જો ફરજિયાત ફીલ્ડ ભરેલા ન હોય તો બચત કરવાની મંજૂરી આપો"

msgid "Allow stock to go below zero for this item, even if negative stock is disabled in Stock Settings."
msgstr "આ વસ્તુ માટે મફતમાં જમા થવા દો, જે નકારાત્મક જમાનાની વ્યવસ્થા કરે છે."

msgid "Allow substituting this item with an alternative from the Item Alternative list when stock is unavailable."
msgstr "આ વિકલ્પને બદલે જ્યારે સ્ટોક ઉપલબ્ધ હોય ત્યારે તેને અવેજીમાં બદલવાની મંજૂરી આપો."

msgid "Allow switching between list, kanban, report, and other views from the toolbar"
msgstr "યાદી, માહિતી, રિપોર્ટ, અને અન્ય માહિતીને આઉટપુટબારમાંથી સ્વિચ કરવાની મંજૂરી આપો"

msgid "Allow the following users to approve Leave Applications for block days."
msgstr "નીચેના વપરાશકર્તાઓને બ્લોક દિવસો માટે રજા માટેની અરજીઓ મંજૂર કરવાની મંજૂરી આપો."

msgid "Allow this item to be used in purchase transactions."
msgstr "આ વસ્તુઓને ખરીદી અને વ્યવહારો કરવા માટે ઉપયોગમાં લેવા દો."

msgid "Allow this item to be used in sales transactions."
msgstr "આ વસ્તુઓને વ્યવહારો કરવા માટે ઉપયોગમાં લેવા દો."

msgid "Allow to edit stock UOM qty for Purchase documents"
msgstr "ખરીદી દસ્તાવેજો માટે સ્ટોક UOM qty સંપાદિત કરવાની મંજૂરી આપો"

msgid "Allow to edit stock UOM qty for Sales documents"
msgstr "વેચાણ દસ્તાવેજો માટે સ્ટોક UOM qty સંપાદિત કરવાની મંજૂરી આપો"

msgid "Allow to edit stock UOM qty for Stock Entry"
msgstr "જસ્ટ સ્ટોક પ્રવેશ માટે પરવાનગી આપો"

msgid "Allow to make Quality Inspection after Purchase / Delivery"
msgstr "ખરીદી / ડિલિવરી પછી ગુણવત્તા નિરીક્ષણ કરવાની મંજૂરી આપો"

msgid "Allow transferring raw materials even after the Required Quantity is fulfilled"
msgstr "જરૂરી સામગ્રીની સંખ્યા પૂર્ણ થયા પછી જ સામગ્રીને સ્થાનાંતરિત કરવાની મંજૂરી આપો"

msgid "Allow user to login only after this hour (0-24)"
msgstr "વપરાશકર્તાને આ કલાક પછી જ લોગિન કરવાની મંજૂરી આપો (0-24)"

msgid "Allow user to login only before this hour (0-24)"
msgstr "વપરાશકર્તાને આ કલાક પહેલા જ લૉગિન કરવાની મંજૂરી આપો (0-24)"

msgid "Allow users to log in without a password, using a login link sent to their email"
msgstr "વપરાશકર્તાઓને તેમના ઈમેલ પર મોકલવામાં આવેલી લૉગિન લિંકનો ઉપયોગ કરીને પાસવર્ડ વિના લૉગ ઇન કરવાની મંજૂરી આપો"

msgid "Allowed"
msgstr "મંજૂર"

msgid "Allowed Dimension"
msgstr "મંજૂરી થયેલ કદ"

msgid "Allowed Doctypes for Guest Uploads"
msgstr "અતિથિ અપલોડ્સ માટે મંજૂર દસ્તાવેજો"

msgid "Allowed File Extensions"
msgstr "મંજૂર ફાઇલ એક્સ્ટેન્શન્સ"

msgid "Allowed In Mentions"
msgstr "ઉલ્લેખમાં મંજૂરી છે"

msgid "Allowed Modules"
msgstr "મંજૂર મોડ્યુલો"

msgid "Allowed Public Client Origins"
msgstr "મંજૂર જાહેર ગ્રાહક મૂળ"

msgid "Allowed Roles"
msgstr "મંજૂર ભૂમિકાઓ"

msgid "Allowed To Transact With"
msgstr "સાથે વ્યવહાર કરવા માટે પરવાનગી"

msgid "Allowed Users"
msgstr "મંજૂરી થયેલ વપરાશકર્તાઓ"

msgid "Allowed Users is not required as Frappe CRM is already installed on the site."
msgstr "પરવાનગી આપેલ વપરાશકર્તાઓએ સાઇટ પર પહેલેથી જ સ્થાપિત થયેલ છે."

msgid "Allowed Users is required for data synchronization from remote Frappe CRM site."
msgstr "દૂરસ્થ સાઇટ પરથી ડેટા સિંક્રનાઇઝેશન માટે પરવાનગી આપેલ વપરાશકર્તાઓની જરૂર છે."

msgid "Allowed embedding domains"
msgstr "ડોમેન્સ એમ્બેડ કરવાની મંજૂરી છે"

msgid "Allowed primary roles are 'Customer' and 'Supplier'. Please select one of these roles only."
msgstr "મંજૂર પ્રાથમિક ભૂમિકાઓ 'ગ્રાહક' અને 'સપ્લાયર' છે. કૃપા કરીને આમાંથી માત્ર એક ભૂમિકા પસંદ કરો."

msgid "Allowed special characters are '/' and '-'"
msgstr "મંજૂર વિશિષ્ટ અક્ષરો '/' અને '-' છે"

msgid "Allowed to transact with"
msgstr "સાથેના વેપારને મંજૂરી"

msgid "Allowed: {0}"
msgstr "મંજૂરીઃ {0}"

msgid "Allows allocating more leaves than the number of days in the allocation period."
msgstr "આ જમાવટના સમયગાળામાં જમાવટના દિવસોની સંખ્યા કરતાં વધુ જમાવટની મંજૂરી આપે છે."

msgid "Allows enabled Social Login Key Base URL to be shown as authorization server."
msgstr "સક્ષમ સામાજિક લૉગિન કી બેઝ URL ને અધિકૃતતા સર્વર તરીકે બતાવવાની મંજૂરી આપે છે."

msgid "Allows printing or PDF download of documents."
msgstr "દસ્તાવેજોની પ્રિન્ટિંગ અથવા પીડીએફ ડાઉનલોડ કરવાની મંજૂરી આપે છે."

msgid "Allows sharing document access with other users."
msgstr "અન્ય વપરાશકર્તાઓ સાથે દસ્તાવેજ ઍક્સેસ શેર કરવાની મંજૂરી આપે છે."

msgid "Allows skipping authorization if a user has active tokens."
msgstr "જો વપરાશકર્તા પાસે સક્રિય ટોકન્સ હોય તો અધિકૃતતા છોડવાની મંજૂરી આપે છે."

msgid "Allows the user to access reports related to the document."
msgstr "વપરાશકર્તાને દસ્તાવેજથી સંબંધિત રિપોર્ટ્સ ઍક્સેસ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to amend a cancelled document into a new copy."
msgstr "વપરાશકર્તાને કાઢી નાખવામાં આવેલ દસ્તાવેજને નવી નકલમાં મૂકવાની મંજૂરી આપે છે."

msgid "Allows the user to cancel submitted documents."
msgstr "વપરાશકર્તાને સબમિટ કરેલા દસ્તાવેજોને રદ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to create new documents."
msgstr "વપરાશકર્તાને નવા દસ્તાવેજો બનાવવાની મંજૂરી આપે છે."

msgid "Allows the user to delete documents."
msgstr "વપરાશકર્તાને દસ્તાવેજો કાઢી નાખવાની મંજૂરી આપે છે."

msgid "Allows the user to edit existing records they have access to."
msgstr "વપરાશકર્તાને તેમની પાસે ઍક્સેસ હોય તેવા હાલના રેકોર્ડ્સને સંપાદિત કરવાની મંજૂરી આપે છે."

msgid "Allows the user to email from the document."
msgstr "વપરાશકર્તાને દસ્તાવેજમાંથી ઇમેઇલ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to export data from the Report view."
msgstr "વપરાશકર્તાને રિપોર્ટ દૃશ્યમાંથી ડેટા નિકાસ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to export document data from the system."
msgstr "વપરાશકર્તાને સિસ્ટમમાંથી દસ્તાવેજ અને ડેટાને નિકાસ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to print or download the document as a PDF."
msgstr "વપરાશકર્તાને દસ્તાવેજને છાપવા માટે પરવાનગી આપે છે."

msgid "Allows the user to search and see records."
msgstr "વપરાશકર્તાને રેકોર્ડ્સ શોધવા અને જોવાની મંજૂરી આપે છે."

msgid "Allows the user to search and select records in other forms. This does not allow the user to view the record itself."
msgstr "વપરાશકર્તાને અન્ય સ્વરૂપોમાં રેકોર્ડ શોધવા અને પસંદ કરવાની મંજૂરી આપે છે. આ વપરાશકર્તાને રેકોર્ડ પોતે જોવાની મંજૂરી આપતું નથી."

msgid "Allows the user to send emails linked to the document."
msgstr "વપરાશકર્તાને દસ્તાવેજ સાથે જોડાયેલ ઇમેઇલ્સ મોકલવા દે છે."

msgid "Allows the user to share document access with other users who may not have access to the document themselves."
msgstr "વપરાશકર્તાને દસ્તાવેજ શેર કરવાની મંજૂરી આપે છે અન્ય વપરાશકર્તાઓ સાથે ઍક્સેસ કરે છે જેમને જાતે જ દસ્તાવેજ શેર કરવાની મંજૂરી નથી."

msgid "Allows the user to submit documents."
msgstr "વપરાશકર્તાને દસ્તાવેજો રજૂ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to use Data Import tool to create / update records."
msgstr "વપરાશકર્તાને રેકોર્ડ બનાવવા/અપડેટ કરવા માટે ડેટા આયાત સાધનનો ઉપયોગ કરવાની મંજૂરી આપે છે."

msgid "Allows the user to use import documents into the system."
msgstr "વપરાશકર્તાને સિસ્ટમ પર દસ્તાવેજોની આયાત કરવાની મંજૂરી આપે છે."

msgid "Allows the user to view the document."
msgstr "વપરાશકર્તાને દસ્તાવેજ જોવાની મંજૂરી આપે છે."

msgid "Allows the user to view the value of a masked field in the document."
msgstr "વપરાશકર્તાને દસ્તાવેજની સમીક્ષા કરવા માટે પરવાનગી આપે છે."

msgid "Allows to keep aside a specific quantity of inventory for a particular order."
msgstr "ચોક્કસ વ્યવસ્થા માટે ઇન્વેન્ટરી વ્યવસ્થાની સંખ્યાને જાળવી રાખવા માટે પરવાનગી આપે છે."

msgid "Allows users to enable the mask property for any field of the respective doctype."
msgstr "વપરાશકર્તાઓને સંબંધિત દસ્તાવેજના કોઈપણ ક્ષેત્ર માટે માસ્ક ગુણધર્મને સક્ષમ કરવાની મંજૂરી આપે છે."

msgid "Allows users to submit Purchase Orders with zero quantity. Useful when rates are fixed but the quantities are not. Eg. Rate Contracts."
msgstr "વપરાશકર્તાઓને જમા કરાવવા માટે પરવાનગી આપે છે ઓર્ડર ખરીદવા માટે જમા કરાવવા માટે જમા કરાવવા માટે જમા કરાવવા માટે જમા કરાવવા માટે જમા કરાવવા માટે જમા કરાવવા માટે જમા કરાવવાની મંજૂરી આપે છે."

msgid "Allows users to submit Request for Quotations with zero quantity. Useful when rates are fixed but the quantities are not. Eg. Rate Contracts."
msgstr "વપરાશકર્તાઓએ વિનંતીઓ કરવા માટે વિનંતીઓ કરવા માટે પરવાનગી આપે છે જ્યારે તેઓ નકારાત્મક સંખ્યામાં હોય ત્યારે."

msgid "Allows users to submit Supplier Quotations with zero quantity. Useful when rates are fixed but the quantities are not. Eg. Rate Contracts."
