msgid "A person you deal with, at a customer, supplier or anywhere else."
msgstr "વ્યક્તિઓ સાથે વ્યવહાર કરો, ગ્રાહકો સાથે વ્યવહાર કરો, સપ્લાયર્સ સાથે વ્યવહાર કરો."

msgid "A phone call made or received."
msgstr "ફોન પર ફોન આવ્યો હતો."

msgid "A piece of work to be done, often part of a project."
msgstr "એક ભાગ કામ કરવા માટે કરવામાં આવે છે, સામાન્ય રીતે પ્રોજેક્ટ ભાગ છે."

msgid "A piece of work with tasks, time and costs."
msgstr "કામના ભાગો, સમય અને ખર્ચ સાથે કામ."

msgid "A place where you keep stock."
msgstr "એક સ્થળ જ્યાં તમે સ્ટોક રાખવા."

msgid "A place where your assets are kept."
msgstr "એક સ્થળ જ્યાં તમારા અકાઉન્ટો રાખવામાં આવે છે."

msgid "A postal address of a customer, supplier, company or contact."
msgstr "ગ્રાહક, સપ્લાયર, કંપનીનો સંપર્ક કરો."

msgid "A potential sale to a lead or customer."
msgstr "સંભવિત ગ્રાહકના વેચાણની વ્યવસ્થા."

msgid "A private workspace is yours alone. Only you can see it."
msgstr "એક ખાનગી કાર્યસ્થળ તમારું એકલું છે. ફક્ત તમે જ તેને જોઈ શકો છો."

msgid "A problem or question raised by a customer."
msgstr "સમસ્યાનો ઉકેલ ગ્રાહક દ્વારા ઉઠાવવામાં આવ્યો છે."

msgid "A product or service you buy, sell or keep in stock."
msgstr "ઉત્પાદન અને સેવા ખરીદવી, સ્ટોક જાળવી રાખવી."

msgid "A progress update collected from the project team."
msgstr "પ્રોજેક્ટ ટીમમાંથી એકત્રિત કરાયેલ માહિતી."

msgid "A property item variants differ by, like size or colour."
msgstr "મિલકત વિવિધ રંગો, રંગો અને રંગો."

msgid "A published list of codes, like units or tax categories, used in e-invoicing."
msgstr "ઈ-ઈનવોઈસિંગમાં ઉપયોગમાં લેવાતા એકમો અથવા ટેક્સ કેટેગરી જેવા કોડની પ્રકાશિત સૂચિ."

msgid "A quality inspection must be completed before generating a Delivery Note for this item."
msgstr "આ વિષય માટે ડિલિવરીની માહિતી પેદા કરતા પહેલા સમાનતા નિરીક્ષણ પૂર્ણ થવું આવશ્યક છે."

msgid "A quality inspection must be completed before generating a Purchase Receipt for this item."
msgstr "આ વસ્તુ માટે ખરીદીની રસીદ પેદા કરતા પહેલા સમાનતા નિરીક્ષણ પૂર્ણ થવું આવશ્યક છે."

msgid "A record of maintenance done on an asset."
msgstr "એક રેકોર્ડર જાળવણીની કામગીરી હાથ ધરવામાં આવી છે."

msgid "A record of shares issued, bought back or moved between shareholders."
msgstr "શેરહોલ્ડરો વચ્ચે શેરની નોંધણી કરવામાં આવી છે."

msgid "A recurring {0} {1} has been created for you via Auto Repeat {2}."
msgstr "રિકરિંગ {0} {1} તમારા માટે સ્વતઃ પુનરાવર્તિત {2} દ્વારા બનાવવામાં આવ્યું છે."

msgid "A region you sell in, to group customers and set targets."
msgstr "પ્રદેશો અને ગ્રાહકોના જૂથો અને લક્ષ્યોને નિયત કરે છે."

msgid "A regular email summing up how the business is doing."
msgstr "સામાન્ય રીતે વ્યવસાયનું સંચાલન થાય છે."

msgid "A reminder to a customer about an overdue invoice."
msgstr "મુદતવીતી ઇન્વૉઇસ વિશે ગ્રાહકને રિમાઇન્ડર."

msgid "A repair made to an asset, and what it cost."
msgstr "સમારકામ કરવામાં આવ્યું હતું, ખર્ચ કરવામાં આવ્યો હતો."

msgid "A request to buy, transfer or make items."
msgstr "હું ખરીદી, પરિવહન, અથવા વસ્તુઓ બનાવવા માટે વિનંતી કરું છું."

msgid "A sale made at the point of sale."
msgstr "વેચાણની વાત કરવામાં આવી છે."

msgid "A saved set of accounts to start journal entries from."
msgstr "એકત્રિત થયેલ એકાઉન્ટ્સની સંખ્યામાં સંખ્યાબંધ એકાઉન્ટ્સની સંખ્યામાં વધારો થયો છે."

msgid "A separate Purchase Order is created for each Supplier."
msgstr "એક અલગ ખરીદી ઓર્ડર દરેક સપ્લાયર માટે બનાવવામાં આવે છે."

msgid "A separate set of books, for example to depreciate assets under another rule."
msgstr "અલગ-અલગ પુસ્તકો, ઉદાહરણ તરીકે, અન્ય નિયમો હેઠળના અયોગ્ય પુસ્તકો."

msgid "A series of emails sent to leads or contacts on a schedule."
msgstr "શેડ્યૂલ પર લીડ્સ અથવા સંપર્કોને મોકલવામાં આવેલી ઇમેઇલ્સની શ્રેણી."

msgid "A set of discounts and free items, like buy two get one free."
msgstr "ડિસ્કાઉન્ટ અને મફત વસ્તુઓનો સમૂહ, જેમ કે બે ખરીદો, એક મફત મેળવો."

msgid "A set of item prices for buying, selling or both."
msgstr "ખરીદી, વેચાણ અથવા બંને માટે આઇટમ કિંમતોનો સમૂહ."

msgid "A set of payment terms to apply to invoices and orders."
msgstr "ઇન્વૉઇસ અને ઑર્ડર્સ પર લાગુ કરવા માટે ચુકવણીની શરતોનો સમૂહ."

msgid "A set of tasks to start new projects from."
msgstr "નવા પ્રોજેક્ટ્સ શરૂ કરવા માટે કાર્યોની વ્યવસ્થા કરવી."

msgid "A short code added to account names, like Cash - AC."
msgstr "ખાતાના નામોમાં ટૂંકો કોડ ઉમેરવામાં આવ્યો છે, જેમ કે રોકડ - AC."

msgid "A sidebar needs at least one entry that leads somewhere. Put one back, or use Reset to drop this arrangement."
msgstr "સાઇડબારમાં ઓછામાં ઓછી એક એન્ટ્રીની જરૂર છે જે ક્યાંક લઈ જાય. એક પાછળ મૂકો, અથવા આ ગોઠવણ છોડવા માટે રીસેટનો ઉપયોગ કરો."

msgid "A single unit of an item, tracked by its own number."
msgstr "એક જ એકમ, એક જ સંખ્યા દ્વારા અનુસરવામાં આવે છે."

msgid "A standard Kanban Board cannot be private"
msgstr "પ્રમાણભૂત જનતા કેનબાન જનતા બોર્ડ ખાનગી જનતા બની શકતું નથી"

msgid "A standard Kanban Board cannot be renamed"
msgstr "પ્રમાણભૂત જનરેશન બોર્ડ નામ બદલી શકાતું નથી"

msgid "A standard Kanban Board must use Kanban v2"
msgstr "પ્રમાણભૂત કાનબન બોર્ડે Kanban v2 નો ઉપયોગ કરવો આવશ્યક છે"

msgid "A standard list layout cannot belong to a user"
msgstr "માનક સૂચિ લેઆઉટ વપરાશકર્તાની નથી"

msgid "A standard sidebar needs a module or an app to be written to."
msgstr "પ્રમાણભૂત સાઇડબારમાં લખવા માટે મોડ્યુલ અથવા એપ્લિકેશનની જરૂર છે."

msgid "A standard workspace belongs to the module that ships it."
msgstr "એક પ્રમાણભૂત કામ જગ્યા છે જે મોડ્યુલ સાથે જોડાયેલી છે."

msgid "A standard workspace is shipped by the app; changes are saved as customizations."
msgstr "એપ્લિકેશન દ્વારા પ્રમાણભૂત કાર્યસ્થળ મોકલવામાં આવે છે; ફેરફારો કસ્ટમાઇઝેશન તરીકે સાચવવામાં આવે છે."

msgid "A standard workspace stays in the module that ships it."
msgstr "સ્ટાન્ડર્ડ વર્કસ્પેસ મોડ્યુલોને જાળવી રાખે છે જે કામ કરે છે."

msgid "A step in making an item, like cutting or assembly."
msgstr "એક પગલું છે, એક વસ્તુ છે, એક મંડળ છે."

msgid "A step in your sales process, like qualification or negotiation."
msgstr "તમારી સેલ્સ પ્રક્રિયાને અનુસરો, લાયકાતની પ્રક્રિયાને અનુસરો."

msgid "A symbol for this currency. For e.g. $"
msgstr "આ ચલણ માટેનું પ્રતીક."

msgid "A task becomes Overdue on its own once its Expected End Date passes"
msgstr "એકવાર તેની અપેક્ષિત સમાપ્તિ તારીખ પસાર થઈ જાય તે પછી કાર્ય તેની જાતે જ ઓવરડ્યુ થઈ જાય છે"

msgid "A template already exists for field {0} of {1}"
msgstr "{1} ના {0} ફીલ્ડ માટે ટેમ્પલેટ પહેલેથી જ અસ્તિત્વમાં છે"

msgid "A unit you measure items in, like kg or box."
msgstr "એક એકમ જેમાં તમે વસ્તુઓને માપો છો, જેમ કે કિલો અથવા બોક્સ."

msgid "A value a scorecard criterion is calculated from."
msgstr "મૂલ્યાંકનકાર્ડની માપદંડની ગણતરી કરવામાં આવે છે."

msgid "A value from a linked document"
msgstr "કડી થયેલ દસ્તાવેજમાંથી મૂલ્યાંકન"

msgid "A vehicle's route to deliver to several customers."
msgstr "વાહનોના માર્ગને અનેક ગ્રાહકો સુધી પહોંચાડવામાં આવે છે."

msgid "A verified appointment cannot be moved back to 'Unverified' status."
msgstr "ચકાસાયેલ નિમણૂક 'અ ચકાસાયેલ' સ્થિતિ પર પાછા ફરવા માટે ખસેડવામાં આવી શકતી નથી."

msgid "A view of your workstations and what each is doing."
msgstr "તમારા કાર્યસ્થળોની સમીક્ષા કરો અને જે કાર્ય થઈ રહ્યું છે તે જુઓ."

msgid "A visit to service or repair what a customer bought."
msgstr "ગ્રાહક દ્વારા ખરીદવામાં આવેલી સેવાઓની મુલાકાત લો."

msgid "A way you pay or get paid, like cash, bank transfer or card."
msgstr "તમે ચૂકવણી કરો છો, તમે પૈસા કમાવો છો, તમે બેંક ટ્રાન્સફર કરો છો."

msgid "A word by itself is easy to guess."
msgstr "એક શબ્દ પોતે જ અનુમાન લગાવવા માટે સરળ છે."

